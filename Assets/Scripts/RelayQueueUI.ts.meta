  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #A3C2D0;\">RelayQueueUI — the spatial work queue surface</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject cardsRoot {"hint":"Authored SceneObject the card deck is built under. Move it to move the whole queue."}'
    - '// @input SceneObject statusRoot {"hint":"Authored SceneObject the data-source status pill is built under."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float cardWidthCm {"hint":"Width of a queue card, in centimetres. The arc fit is derived from this.", "widget":"slider", "min":6, "max":24, "step":0.5}'
    - '// @input float cardHeightCm {"hint":"Height of a queue card, in centimetres.", "widget":"slider", "min":6, "max":18, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Material"}'
    - '// @input float contentDepthCm = 0.3 {"hint":"How far the text floats in FRONT of the plate, in cm. This gap is the parallax: move your head and the text slides across the plate behind it.", "widget":"slider", "min":0, "max":1.5, "step":0.05}'
    - '// @input float gradientPoolGain = 2.2 {"hint":"Brightness of the fill at the BOTTOM edge, where light pools in the glass. 1 = flat.", "widget":"slider", "min":1, "max":4, "step":0.05}'
    - '// @input float gradientTopGain = 0.45 {"hint":"Brightness of the fill at the TOP edge. Lower = steeper pool.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float breathAmplitude = 0.04 {"hint":"Edge-brightness swing of a MAXIMUM-urgency card. Priority 1 never breathes; the pulse scales with urgency.", "widget":"slider", "min":0, "max":0.15, "step":0.005}'
    - '// @input float breathPeriodMs = 2000 {"hint":"One full breath, in milliseconds.", "widget":"slider", "min":800, "max":4000, "step":100}'
    - '// @input float hoverTiltDegrees = 3 {"hint":"Degrees the card tilts toward you when a hand approaches.", "widget":"slider", "min":0, "max":10, "step":0.5}'
    - '// @input vec4 unclaimedColor = "{0.639, 0.761, 0.816, 1.0}" {"hint":"Mineral #A3C2D0 — an unclaimed item. Colour encodes ownership and nothing else.", "widget":"color"}'
    - '// @input vec4 yoursColor = "{0.435, 0.780, 0.608, 1.0}" {"hint":"Jade #6FC79B — an item you have claimed.", "widget":"color"}'
    - '// @input vec4 partnersColor = "{0.722, 0.643, 0.941, 1.0}" {"hint":"Lilac #B8A4F0 — an item your partner has claimed.", "widget":"color"}'
    - '// @input vec4 doneColor = "{0.400, 0.459, 0.486, 1.0}" {"hint":"Graphite #66757C — a completed item. Always rendered at low opacity.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
