    Node5:
      DependencyIndex: 5
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 tint;
            input_float faceOpacity;
            input_float edgeOpacity;
            input_float frost;
            input_float intensity;
            output_vec4 result;
            
            // A SOLID SLAB, not a light.
            //
            // Nothing here is emissive and nothing blooms — five sessions established that this
            // preview will not render soft light, so this describes a SURFACE instead. Opacity is
            // driven by viewing angle: the face you are looking at stays clean and nearly clear so
            // the text on it reads, while a face turned edge-on to you becomes dense and frosted.
            // That is what real glass does, and it means head movement alone reveals the thickness.
            void main()
            {
            	vec3 n = normalize(system.getSurfaceNormalCameraSpace());
            	vec3 v = normalize(-system.getSurfacePositionCameraSpace());
            
            	// 1 when a face points straight at the viewer, 0 when it is seen edge-on.
            	float facing = clamp(abs(dot(n, v)), 0.0, 1.0);
            	float edge = 1.0 - facing;
            	edge = edge * edge;
            
            	// Frost, on the sides only. A cheap hash keeps it per-pixel without a texture; the
            	// face stays smooth because `edge` is near zero there.
            	vec2 uv = system.getSurfaceUVCoord0();
            	float g = fract(sin(dot(uv * vec2(97.3, 61.7), vec2(12.9898, 78.233))) * 43758.5453);
            	float grain = mix(1.0, 0.72 + g * 0.56, clamp(frost, 0.0, 1.0) * edge);
            
            	float a = mix(faceOpacity, edgeOpacity, edge) * grain;
            	a = clamp(a, 0.0, 1.0);
            
            	// Intensity stays at or below 1 by construction: pushing it past that is what turned
            	// every previous attempt into a white blob.
            	result = vec4(tint.rgb * clamp(intensity, 0.0, 1.0), a);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
