    Node5:
      DependencyIndex: 5
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 jade;
            input_vec4 lilac;
            input_float progress;
            input_float fade;
            input_float pulseWidth;
            output_vec4 result;
            
            // The crossing, as a surface rather than a light.
            //
            // uv.x runs from the sender's end to the receiver's; uv.y runs across the ribbon. That
            // separation is the whole point: the colour handover and the travelling pulse live on
            // one axis, the soft edge lives on the other, and neither interferes with the other.
            // Nothing is emissive, so there is nothing to bloom into a white blob.
            void main()
            {
            	vec2 uv = system.getSurfaceUVCoord0();
            
            	// Soft along its width, so the ribbon has no hard cut on either side.
            	float across = 1.0 - smoothstep(0.0, 1.0, abs(uv.y - 0.5) * 2.0);
            	across = across * across;
            
            	// The trail exists only BEHIND the leading point — the ribbon draws itself as the
            	// card advances instead of appearing whole.
            	float drawn = 1.0 - smoothstep(progress, progress + 0.05, uv.x);
            	// ...and thins out further back, so it reads as a wake rather than a painted stripe.
            	float tail = mix(0.25, 1.0, clamp(uv.x / max(progress, 0.001), 0.0, 1.0));
            
            	// The leading pulse, running at the head of the draw.
            	float pulse = 1.0 - smoothstep(0.0, max(pulseWidth, 0.01), abs(uv.x - progress));
            	pulse = pulse * pulse;
            
            	// Jade where it left, lilac where it lands. Nothing invented in between.
            	vec3 col = mix(jade.rgb, lilac.rgb, clamp(uv.x, 0.0, 1.0));
            
            	float a = across * (drawn * tail * 0.5 + pulse * 0.85) * fade;
            	result = vec4(col, clamp(a, 0.0, 1.0));
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
